# Local development values. Do not commit a real .env file.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True

# Railway provides DATABASE_URL when linked to its PostgreSQL service.
# DATABASE_URL=postgresql://user:password@host:port/database

# Set on Railway after attaching a Volume at /data to retain uploaded images.
# MEDIA_ROOT=/data
# SERVE_MEDIA=True

# Optional payment configuration
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
